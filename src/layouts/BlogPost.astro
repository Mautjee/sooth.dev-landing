---
// Blog post layout — wraps rendered markdown with readable typography.
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/dates';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}
const { title, description, pubDate, tags } = Astro.props;
---

<BaseLayout title={`${title} — SOOTH.dev`} description={description}>
  <article>
    <header class="mb-8">
      <a href="/blog" class="text-sm text-gruvbox-gray hover:text-gruvbox-yellow transition-colors">← Back to blog</a>
      <h1 class="text-3xl md:text-4xl font-bold text-gruvbox-yellow mt-4 leading-tight">{title}</h1>
      <p class="mt-3 text-gruvbox-gray">{description}</p>
      <div class="mt-3 flex items-center gap-3 text-sm text-gruvbox-gray">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      </div>
      {
        tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map(tag => (
              <span class="px-2.5 py-1 text-xs rounded-full bg-gruvbox-dark-bg1 border border-gruvbox-dark-bg2 text-gruvbox-gray">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
