---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.order - b.data.order || a.id.localeCompare(b.id);
});
---

<BaseLayout
  width="wide"
  title="Projects"
  description="Prototypes turned into platforms: five case studies with the commits, pull requests and decisions that cost something."
>
  <header class="page-head wrap">
    <h1>Projects</h1>
    <p class="lede">
      Prototypes turned into platforms. Five case studies, each with the commits, pull requests and
      decisions that cost something.
    </p>
  </header>

  <div class="wrap">
    {
      projects.length === 0 ? (
        <p class="muted">Projects are being added.</p>
      ) : (
        <div class="project-grid">
          {projects.map(project => <ProjectCard project={project} />)}
        </div>
      )
    }
    <p class="index-contact">
      Available for platform, infrastructure and migration work. <a
        href="mailto:sooth.dev@gmail.com">sooth.dev@gmail.com</a
      >
    </p>
  </div>
</BaseLayout>
