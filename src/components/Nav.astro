---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const items = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/cv.pdf', label: 'CV' },
] as const;

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  if (href === '/cv.pdf') return path === '/cv.pdf';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/">sooth.dev</a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          items.map(item => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="nav__mobile">
      <summary>Menu<span class="nav__mobile-icon" aria-hidden="true"></span></summary>
      <nav class="nav__mobile-panel" aria-label="Primary">
        {
          items.map(item => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
