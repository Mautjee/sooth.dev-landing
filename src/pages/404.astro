---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Not found"
  description="That page doesn't exist. It may be an old link, or a typo."
  noindex
>
  <header class="page-head wrap">
    <h1>That page doesn't exist</h1>
    <p class="lede">The link may be old, or the address may have a typo. These are the ways back in.</p>
  </header>

  <div class="wrap">
    <ul class="related__list">
      <li><a href="/">Home</a></li>
      <li><a href="/projects">Projects</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/about">About</a></li>
    </ul>
  </div>
</BaseLayout>
