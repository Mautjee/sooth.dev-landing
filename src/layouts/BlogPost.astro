---
import BaseLayout from './BaseLayout.astro';
import { formatDate, formatIsoDate } from '../lib/dates';
import { extractHeadings, readingTime } from '../lib/content';

interface RelatedItem {
  href: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  body?: string;
  related?: RelatedItem[];
  projectTitle?: string;
  projectHref?: string;
}

const {
  title,
  description,
  pubDate,
  tags,
  body,
  related = [],
  projectTitle,
  projectHref,
} = Astro.props;

const minutes = readingTime(body);
const headings = extractHeadings(body);
---

<BaseLayout title={title} description={description} ogType="article" width="prose">
  <header class="page-head wrap">
    <a class="backlink" href="/blog">← All writing</a>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <p class="meta-row">
      <time datetime={formatIsoDate(pubDate)}>{formatDate(pubDate)}</time>
      <span>{minutes} min read</span>
      {projectTitle && projectHref && <a href={projectHref}>{projectTitle}</a>}
    </p>
    {
      tags.length > 0 && (
        <ul class="chips">
          {tags.map(tag => <li>{tag}</li>)}
        </ul>
      )
    }
  </header>

  <div class="wrap reading">
    <div class="reading__body">
      <article class="prose">
        <slot />
      </article>

      {
        related.length > 0 && (
          <div class="related">
            <p class="related__title">Related</p>
            <ul class="related__list">
              {related.map(item => (
                <li><a href={item.href}>{item.title}</a></li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <aside class="rail" aria-label="Post details">
      <div class="rail__row">
        <span class="rail__label">Published</span>
        <span class="rail__value">{formatIsoDate(pubDate)}</span>
      </div>
      <div class="rail__row">
        <span class="rail__label">Reading time</span>
        <span class="rail__value">{minutes} minutes</span>
      </div>
      {
        projectTitle && projectHref && (
          <div class="rail__row">
            <span class="rail__label">Project</span>
            <span class="rail__value"><a href={projectHref}>{projectTitle}</a></span>
          </div>
        )
      }
      {
        tags.length > 0 && (
          <div class="rail__row">
            <span class="rail__label">Tags</span>
            <span class="rail__value">{tags.join(', ')}</span>
          </div>
        )
      }
      {
        headings.length > 0 && (
          <nav class="rail__row" aria-label="On this page">
            <span class="rail__label">On this page</span>
            <div class="rail__links">
              {headings.map(heading => (
                <a href={`#${heading.id}`}>{heading.text}</a>
              ))}
            </div>
          </nav>
        )
      }
    </aside>
  </div>
</BaseLayout>
