---
import ClientRouter from 'astro/components/ClientRouter.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Meta from '../components/Meta.astro';
import { canonicalPath, ogKindFor, OG_IMAGE, pageTitle } from '../lib/seo';
import '../styles/global.css';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  width?: 'prose' | 'wide';
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  width = 'prose',
  ogType = 'website',
  ogImage,
  noindex = false,
} = Astro.props;

const canonical = canonicalPath(Astro.url.pathname);
const ogKind = ogKindFor(canonical);
const image = ogImage ?? OG_IMAGE[ogKind];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Meta
      title={pageTitle(title)}
      description={description}
      canonical={canonical}
      ogType={ogType}
      ogImage={image}
      ogKind={ogKind}
      noindex={noindex}
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" class:list={['site-main', `site-main--${width}`]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
