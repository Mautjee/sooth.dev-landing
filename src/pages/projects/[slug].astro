---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { extractHeadings } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const statusLabels = {
  active: 'Active',
  completed: 'Completed',
  archived: 'Archived',
  private: 'Private',
} as const;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const relatedPosts = posts.filter(post => post.data.project === project.id).slice(0, 3);
const headings = extractHeadings(project.body);
---

<BaseLayout title={d.title} description={d.summary} ogType="article" width="wide">
  <header class="page-head wrap">
    <a class="backlink" href="/projects">← All projects</a>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <p class="meta-row">
      <span>{d.role}</span>
      {d.period && <span>{d.period}</span>}
      <span>{statusLabels[d.status]}</span>
      {d.repo && <a href={d.repo} target="_blank" rel="noopener noreferrer">Repository ↗</a>}
      {d.live && <a href={d.live} target="_blank" rel="noopener noreferrer">Live ↗</a>}
    </p>
    {
      d.stack.length > 0 && (
        <ul class="chips">
          {d.stack.map(item => <li>{item}</li>)}
        </ul>
      )
    }
  </header>

  <div class="wrap reading">
    <div class="reading__body">
      <article class="prose">
        <Content />
      </article>

      {
        relatedPosts.length > 0 && (
          <div class="related">
            <p class="related__title">Related</p>
            <ul class="related__list">
              {relatedPosts.map(post => (
                <li><a href={`/blog/${post.id}`}>{post.data.title}</a></li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <aside class="rail" aria-label="Project details">
      <div class="rail__row">
        <span class="rail__label">Role</span>
        <span class="rail__value">{d.role}</span>
      </div>
      {
        d.period && (
          <div class="rail__row">
            <span class="rail__label">Period</span>
            <span class="rail__value">{d.period}</span>
          </div>
        )
      }
      <div class="rail__row">
        <span class="rail__label">Status</span>
        <span class="rail__value">{statusLabels[d.status]}</span>
      </div>
      <div class="rail__row">
        <span class="rail__label">Stack</span>
        <span class="rail__value">{d.stack.join(', ')}</span>
      </div>
      {
        (d.repo || d.live) && (
          <div class="rail__row">
            <span class="rail__label">Links</span>
            <span class="rail__value">
              {d.repo && <a href={d.repo} target="_blank" rel="noopener noreferrer">Repository ↗</a>}
              {d.live && <a href={d.live} target="_blank" rel="noopener noreferrer">Live ↗</a>}
            </span>
          </div>
        )
      }
      {
        headings.length > 0 && (
          <nav class="rail__row" aria-label="On this page">
            <span class="rail__label">On this page</span>
            <div class="rail__links">
              {headings.map(heading => (
                <a href={`#${heading.id}`}>{heading.text}</a>
              ))}
            </div>
          </nav>
        )
      }
    </aside>
  </div>
</BaseLayout>
