---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return a.data.order - b.data.order;
  });

const statusLabels = {
  active: 'Active',
  completed: 'Completed',
  archived: 'Archived',
  private: 'Private',
} as const;
---

<BaseLayout title="Projects — SOOTH.dev" description="Selected work by Mauro Eijsenring.">
  <header class="mb-10">
    <h1 class="text-3xl md:text-4xl font-bold text-gruvbox-yellow">Projects</h1>
    <p class="mt-2 text-gruvbox-gray">Selected work — taking prototypes and making them into platforms.</p>
  </header>

  {
    projects.length === 0 && (
      <p class="text-gruvbox-gray italic">Projects are being added.</p>
    )
  }

  <div class="grid gap-4 sm:grid-cols-2">
    {projects.map(project => (
      <a
        href={`/projects/${project.id}`}
        class="block p-5 bg-gruvbox-dark-bg1 hover:bg-gruvbox-dark-bg2 border border-gruvbox-dark-bg1 hover:border-gruvbox-yellow/40 rounded-lg transition-colors group"
      >
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-lg font-semibold text-gruvbox-fg group-hover:text-gruvbox-yellow transition-colors">{project.data.title}</h2>
          {
            project.data.featured && (
              <span class="shrink-0 px-2 py-0.5 text-xs rounded-full bg-gruvbox-yellow text-gruvbox-dark-bg font-semibold">Featured</span>
            )
          }
        </div>
        <p class="mt-1 text-sm text-gruvbox-gray">{project.data.role} · {project.data.period}</p>
        <p class="mt-3 text-sm text-gruvbox-fg line-clamp-3">{project.data.summary}</p>
        {
          project.data.stack.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {project.data.stack.slice(0, 6).map(item => (
                <span class="px-2 py-0.5 text-xs rounded-full bg-gruvbox-dark-bg2 text-gruvbox-gray">{item}</span>
              ))}
              {project.data.stack.length > 6 && (
                <span class="px-2 py-0.5 text-xs rounded-full bg-gruvbox-dark-bg2 text-gruvbox-gray">+{project.data.stack.length - 6}</span>
              )}
            </div>
          )
        }
      </a>
    ))}
  </div>
</BaseLayout>
