---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import avatar from '../assets/ava.png';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const projects = await getCollection('projects');
const ranked = [...projects].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.order - b.data.order || a.id.localeCompare(b.id);
});
const selected = ranked.slice(0, 3);
const latestPosts = posts.slice(0, 3);

const proof = [
  {
    value: '678',
    label: 'commits on Aztecscan, a production block explorer',
    source: 'of 1,812 · aztec-scan/chicmoz',
  },
  {
    value: '40',
    label: 'pull requests on a client Kubernetes platform',
    source: 'private repo · 2025–2026',
  },
  {
    value: '70',
    label: 'deploys in the July peak, up from 6 in January',
    source: 'ArgoCD deploy log · Jul 2026',
  },
];
---

<BaseLayout
  width="wide"
  title="Mauro Eijsenring — platform and infrastructure engineer"
  description="I build and run the platform behind the product: Kubernetes, CI/CD, and the guardrails that let AI agents near production."
>
  <section class="hero wrap">
    <div class="hero__grid">
      <div>
        <h1 class="hero__title">Mauro Eijsenring</h1>
        <p class="hero__lede">
          I build and run the platform behind the product — Kubernetes, CI/CD, and lately the
          guardrails that let AI agents near production.
        </p>
        <p class="hero__avail mono">Open to freelance platform and infrastructure work.</p>
      </div>
      <Image
        class="hero__avatar"
        src={avatar}
        width={132}
        height={166}
        alt="Mauro Eijsenring"
        fetchpriority="high"
        loading="eager"
      />
    </div>
  </section>

  <section class="proof" aria-label="Evidence">
    <div class="wrap proof__grid">
      {
        proof.map(item => (
          <div>
            <span class="proof__num">{item.value}</span>
            <span class="proof__label">{item.label}</span>
            <span class="proof__src">{item.source}</span>
          </div>
        ))
      }
    </div>
  </section>

  <Section id="work" title="Selected work" more={{ href: '/projects', label: 'All projects' }}>
    <ol class="work-list">
      {selected.map((project, index) => <ProjectCard project={project} rank={index + 1} />)}
    </ol>
  </Section>

  <Section id="writing" title="Latest writing" more={{ href: '/blog', label: 'All writing' }}>
    <div class="post-list">
      {latestPosts.map(post => <PostCard post={post} showProject />)}
    </div>
  </Section>

  <section class="contact" aria-labelledby="contact-title">
    <div class="wrap contact__inner">
      <div>
        <h2 class="contact__title" id="contact-title">Hire me, or just say hello.</h2>
        <p class="contact__copy">
          I take on platform, infrastructure and migration work — contract or freelance. Email is
          the fastest way to reach me.
        </p>
      </div>
      <div class="contact__links">
        <a class="button" href="mailto:sooth.dev@gmail.com">sooth.dev@gmail.com</a>
        <div class="contact__secondary">
          <a class="contact__link" href="https://github.com/Mautjee">GitHub</a>
          <a class="contact__link" href="https://www.linkedin.com/in/mauro-eijsenring/">LinkedIn</a>
          <a class="contact__link" href="/cv.pdf">CV</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
